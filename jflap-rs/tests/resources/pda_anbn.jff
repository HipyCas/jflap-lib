<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Created with JFLAP 7.0.-->
<structure>
  <type>pda</type>
  <automaton>
    <!--The list of states.-->
    <state id="0" name="q0">
      <x>100.0</x>
      <y>150.0</y>
      <initial/>
    </state>
    <state id="1" name="q1">
      <x>250.0</x>
      <y>150.0</y>
    </state>
    <state id="2" name="q2">
      <x>400.0</x>
      <y>150.0</y>
      <final/>
    </state>
    <!--The list of transitions.-->
    <!-- Push an A for each 'a' read -->
    <transition>
      <from>0</from>
      <to>0</to>
      <read>a</read>
      <pop>Z</pop>
      <push>AZ</push>
    </transition>
    <transition>
      <from>0</from>
      <to>0</to>
      <read>a</read>
      <pop>A</pop>
      <push>AA</push>
    </transition>
    <!-- Switch to pop mode on first 'b' -->
    <transition>
      <from>0</from>
      <to>1</to>
      <read>b</read>
      <pop>A</pop>
      <push></push>
    </transition>
    <!-- Continue popping for each 'b' -->
    <transition>
      <from>1</from>
      <to>1</to>
      <read>b</read>
      <pop>A</pop>
      <push></push>
    </transition>
    <!-- Lambda to accepting state when stack has only Z -->
    <transition>
      <from>1</from>
      <to>2</to>
      <read></read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>
  </automaton>
</structure>
