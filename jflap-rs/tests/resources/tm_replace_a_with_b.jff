<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Created with JFLAP 7.0.-->
<structure>
  <type>turing</type>
  <automaton>
    <!--
      Simple TM that accepts strings of a's and replaces each 'a' with 'b'.
      Halts (accepts) when it reaches a blank.
    -->
    <state id="0" name="q0">
      <x>100.0</x>
      <y>150.0</y>
      <initial/>
    </state>
    <state id="1" name="q1">
      <x>300.0</x>
      <y>150.0</y>
      <final/>
    </state>
    <!--The list of transitions.-->
    <!-- Replace each 'a' with 'b', move right -->
    <transition>
      <from>0</from>
      <to>0</to>
      <read>a</read>
      <write>b</write>
      <move>R</move>
    </transition>
    <!-- Blank reached: halt in accepting state -->
    <transition>
      <from>0</from>
      <to>1</to>
      <read>□</read>
      <write>□</write>
      <move>S</move>
    </transition>
  </automaton>
</structure>
